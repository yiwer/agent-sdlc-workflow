{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git rebase *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/capture_evidence.py",
            "timeout": 10,
            "async": true,
            "statusMessage": "捕获验证证据 (A1)"
          }
        ]
      }
    ]
  }
}
